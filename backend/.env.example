DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@YOUR_DB_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional: a publishable or legacy anon key. The server can also use its service key for Auth.
SUPABASE_PUBLISHABLE_KEY=
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
MAX_SUBMISSION_BYTES=262144
# Per 15-minute window; the IP allowance accommodates teams on a shared venue network.
AUTH_IP_LIMIT=300
AUTH_EMAIL_LIMIT=10
GROQ_API_KEY=
# Exactly three DIFFERENT comma-separated Groq model IDs available in your account.
GROQ_EVAL_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-4.1-mini
# Two submissions at once; each fans out to four independent provider requests.
EVALUATION_WORKERS=2
EVALUATION_TIMEOUT=60

